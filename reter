--// Utilities ----------------------------------------------------------------------------------
local function new(class, props, children)
	local inst = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do inst[k] = v end
	if children then for _, c in ipairs(children) do c.Parent = inst end end
	inst.Parent = parent
	return inst
end

local function corner(parent, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = parent })
end

local function padding(parent, t, r, b, l)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r),
		PaddingBottom = UDim.new(0, b), PaddingLeft = UDim.new(0, l), Parent = parent,
	})
end

local function listLayout(parent, gap, horizontal)
	return new("UIListLayout", {
		Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Parent = parent,
	})
end

local function isPress(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
local function isMove(i) return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch end

local function hexOf(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function colorFromHex(text)
	local s = tostring(text):gsub("%s", ""):gsub("^#", "")
	if #s == 3 then s = s:sub(1, 1):rep(2) .. s:sub(2, 2):rep(2) .. s:sub(3, 3):rep(2) end
	if #s ~= 6 or s:find("%X") then return nil end
	return Color3.fromRGB(tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16))
end

local function ago(t)
	local d = os.time() - t
	if d < 5 then return "just now" elseif d < 60 then return d .. "s ago"
	elseif d < 3600 then return math.floor(d / 60) .. "m ago" end
	return math.floor(d / 3600) .. "h ago"
end

local function memoryConfigHandler()
	local store = {}
	return {
		Save = function(name, json) store[name] = json end,
		Load = function(name) return store[name] end,
		Delete = function(name) store[name] = nil end,
		List = function() local t = {} for k in pairs(store) do t[#t + 1] = k end table.sort(t) return t end,
	}
end

--// Core: theming helpers ----------------------------------------------------------------------
function Library:_BuildColors()
	local c = table.clone(Themes[self.ThemeName])
	c.Accent = self.Accent
	local h, s, v = self.Accent:ToHSV()
	c.Accent2 = Color3.fromHSV((h + 0.07) % 1, math.clamp(s * 0.9, 0, 1), math.clamp(v * 1.05, 0, 1))
	for k, v2 in pairs(Status) do c[k] = v2 end
	self.Colors = c
end

local function resolve(colors, v)
	if type(v) == "function" then return v(colors) end
	return colors[v]
end

-- Bind instance properties to theme tokens (string) or functions(colors) -> value.
function Library:Bind(inst, map)
	if #self._bound > 700 then self:_Prune() end
	table.insert(self._bound, { inst, map })
	for prop, v in pairs(map) do inst[prop] = resolve(self.Colors, v) end
	return inst
end

function Library:Unbind(inst)
	for i = #self._bound, 1, -1 do
		if self._bound[i][1] == inst then table.remove(self._bound, i) end
	end
end

function Library:_Prune()
	local alive = {}
	for _, b in ipairs(self._bound) do
		if b[1]:IsDescendantOf(self.Gui) then table.insert(alive, b) end
	end
	self._bound = alive
end

function Library:OnTheme(fn, owner)
	table.insert(self._themeHooks, { fn, owner })
end

function Library:_ApplyTheme()
	self:_BuildColors()
	self:_Prune()
	local smooth = self.Animations and #self._bound < 900
	for _, b in ipairs(self._bound) do
		local goal
		for prop, v in pairs(b[2]) do
			local val = resolve(self.Colors, v)
			if smooth and typeof(val) == "Color3" then
				goal = goal or {}
				goal[prop] = val
			else
				b[1][prop] = val
			end
		end
		if goal then TweenService:Create(b[1], TweenInfo.new(0.3 / self.Speed, Enum.EasingStyle.Quad), goal):Play() end
	end
	local alive = {}
	for _, h in ipairs(self._themeHooks) do
		if not h[2] or h[2]:IsDescendantOf(self.Gui) then
			table.insert(alive, h)
			task.spawn(h[1])
		end
	end
	self._themeHooks = alive
	self:_QueueHome()
end

function Library:_QueueTheme()
	if self._themeQueued then return end
	self._themeQueued = true
	task.defer(function()
		self._themeQueued = false
		self:_ApplyTheme()
	end)
end

function Library:SetTheme(name)
	if not Themes[name] then return end
	self.ThemeName = name
	self:_QueueTheme()
end

function Library:SetAccent(color)
	self.Accent = color
	self:_QueueTheme()
end

function Library:Tween(inst, props, time, style, dir, done)
	if not self.Animations then
		for k, v in pairs(props) do inst[k] = v end
		if done then task.defer(done) end
		return nil
	end
	local tween = TweenService:Create(inst, TweenInfo.new((time or 0.2) / self.Speed, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	if done then
		tween.Completed:Once(function(state)
			if state == Enum.PlaybackState.Completed then done() end
		end)
	end
	tween:Play()
	return tween
end

-- Tracked connection for global signals (UserInputService etc.)
function Library:Connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._conns, c)
	return c
end

--// Core: element factories --------------------------------------------------------------------
function Library:_Text(props, token)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.Font = props.Font or FONT
	props.TextSize = props.TextSize or 13
	props.TextXAlignment = props.TextXAlignment or LEFT
	props.TextColor3 = self.Colors[token or "Text"]
	local l = new("TextLabel", props)
	self:Bind(l, { TextColor3 = token or "Text" })
	return l
end

function Library:_Frame(props, bgToken)
	props.BorderSizePixel = 0
	if bgToken then
		props.BackgroundColor3 = self.Colors[bgToken]
	else
		props.BackgroundTransparency = props.BackgroundTransparency or 1
	end
	local f = new("Frame", props)
	if bgToken then self:Bind(f, { BackgroundColor3 = bgToken }) end
	return f
end

function Library:_Stroke(inst, token, thickness)
	local s = new("UIStroke", { Color = self.Colors[token], Thickness = thickness or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst })
	self:Bind(s, { Color = token })
	return s
end

function Library:_Icon(parent, icon, size, token, props)
	local inst
	icon = icon or "dot"
	-- Resolve glyph name to asset id
	if Glyphs[icon] then icon = Glyphs[icon] end
	local isAsset = type(icon) == "number" or (type(icon) == "string" and (icon:find("^rbxasset") ~= nil))
	if isAsset then
		inst = new("ImageLabel", {
			BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromOffset(size, size),
			Image = type(icon) == "number" and ("rbxassetid://" .. icon) or icon,
			ImageColor3 = self.Colors[token or "Text"], ScaleType = Enum.ScaleType.Fit, Parent = parent,
		})
		self:Bind(inst, { ImageColor3 = token or "Text" })
	else
		inst = self:_Text({
			Text = tostring(icon), Font = FONT_B, TextSize = size,
			Size = UDim2.fromOffset(size, size), TextXAlignment = CENTER, Parent = parent,
		}, token)
	end
	for k, v in pairs(props or {}) do inst[k] = v end
	return inst
end

--// Constructor --------------------------------------------------------------------------------
-- Premium card: a CanvasGroup (fades as one unit) with a faint accent sheen. Returns card, stroke.
function Library:_Card(props, radius)
	props.BorderSizePixel = 0
	props.BackgroundColor3 = self.Colors.Surface
	local card = new("CanvasGroup", props)
	self:Bind(card, { BackgroundColor3 = "Surface" })
	corner(card, radius or 10)
	local stroke = self:_Stroke(card, "Stroke")
	local sheen = new("Frame", { Name = "Sheen", BackgroundColor3 = self.Colors.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 0, Parent = card })
	self:Bind(sheen, { BackgroundColor3 = "Accent" })
	new("UIGradient", {
		Rotation = 35,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.6, 0.98), NumberSequenceKeypoint.new(1, 1) }),
		Parent = sheen,
	})
	return card, stroke
end

-- Animated number counter for a TextLabel.
function Library:CountTo(label, target, fmt)
	fmt = fmt or function(n) return tostring(math.floor(n + 0.5)) end
	local from = label:GetAttribute("count")
	label:SetAttribute("count", target)
	self._counters = self._counters or setmetatable({}, { __mode = "k" })
	local prev = self._counters[label]
	if prev then prev:Destroy() self._counters[label] = nil end
	if from == nil or from == target or not self.Animations then
		label.Text = fmt(target)
		return
	end
	local nv = new("NumberValue", { Value = from })
	self._counters[label] = nv
	nv.Changed:Connect(function(v) label.Text = fmt(v) end)
	local tw = TweenService:Create(nv, TweenInfo.new(0.7 / self.Speed, Enum.EasingStyle.Quint), { Value = target })
	tw.Completed:Once(function()
		label.Text = fmt(target)
		if self._counters[label] == nv then self._counters[label] = nil end
		nv:Destroy()
	end)
	tw:Play()
end

-- Staggered fade-in of the cards on a page.
function Library:_Stagger(tab)
	if not self.Animations then return end
	local top = {}
	for _, c in ipairs(tab.Scroll:GetChildren()) do
		if c:IsA("CanvasGroup") or c.Name == "Stats" then table.insert(top, c) end
	end
	table.sort(top, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	local list = {}
	for _, c in ipairs(top) do
		if c:IsA("CanvasGroup") then
			table.insert(list, c)
		else
			for _, k in ipairs(c:GetChildren()) do
				if k:IsA("CanvasGroup") then table.insert(list, k) end
			end
		end
	end
	for i, c in ipairs(list) do
		c.GroupTransparency = 1
		task.delay(math.min(i, 10) * 0.05 / self.Speed, function()
			if c.Parent then self:Tween(c, { GroupTransparency = 0 }, 0.4) end
		end)
	end
end

function Library.new(opts)
	opts = opts or {}
	local self = setmetatable({}, Library)
	self.Name = opts.Name or "Lumen"
	self.Subtitle = opts.Subtitle or "Interface"
	self.Version = opts.Version or "1.0.0"
	self.ThemeName = Themes[opts.Theme or "Dark"] and (opts.Theme or "Dark") or "Dark"
	self.Accent = opts.AccentColor or Color3.fromRGB(124, 92, 255)
	self.Username = opts.Username or (LocalPlayer and LocalPlayer.DisplayName) or "Player"
	self.Developer = opts.Developer or "Unknown developer"
	self.Credits = opts.Credits or "Built with Lumen UI"
	self.Description = opts.Description or "Your control panel is ready. Pick a tab on the left to get started."
	self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
	self.Size = opts.Size or Vector2.new(720, 460)
	self.ConfigHandler = opts.ConfigHandler or memoryConfigHandler()
	self.Animations, self.Speed, self.UserScale = true, 1, 1
	self.Visible, self.Minimized = false, false
	self.Tabs, self._allTabs, self.Toggles, self.Flags, self.Activity = {}, {}, {}, {}, {}
	self._events = {}
	self._bound, self._themeHooks, self._conns, self._notifs = {}, {}, {}, {}
	self._notifId, self._bindStamp, self._listening = 0, 0, false
	self.UseLauncher = opts.Launcher
	if self.UseLauncher == nil then self.UseLauncher = UserInputService.TouchEnabled end

	self:_BuildColors()
	self:_BuildGui(opts)
	self:OnTheme(function()
		for _, t in ipairs(self._allTabs) do t._style(false) end
	end)
	self:_BuildSettings()
	self:_BuildAbout()

	task.defer(function()
		if not self.Gui.Parent then return end
		self:_InitialSelect()
		self:SetVisible(true)
	end)
	task.spawn(function()
		while self.Gui and self.Gui.Parent do
			task.wait(8)
			if self.Visible and self.Current == self.Home then self:_QueueHome() end
		end
	end)
	return self
end

function Library:_InitialSelect()
	if self.Current then return end
	self:SelectTab(self.Home or self.Tabs[1] or self.SettingsTab)
end

--// Window -------------------------------------------------------------------------------------
function Library:_EffectiveScale()
	local vp = self.Gui.AbsoluteSize
	if vp.X <= 0 or vp.Y <= 0 then return self.UserScale end
	local fit = math.min((vp.X - 24) / self.Size.X, (vp.Y - 24) / self.Size.Y)
	return math.clamp(math.min(self.UserScale, fit), 0.4, 2)
end

function Library:_UpdateScale(animate)
	if not self.Visible then return end
	local s = self:_EffectiveScale()
	if animate then self:Tween(self.Scale, { Scale = s }, 0.25) else self.Scale.Scale = s end
end

function Library:_Resize(w, h)
	local s = self.Scale.Scale
	local p = self.Main.Position
	self.Main.Position = UDim2.new(p.X.Scale, p.X.Offset + (w - self.Size.X) * s / 2, p.Y.Scale, p.Y.Offset + (h - self.Size.Y) * s / 2)
	self.Main.Size = UDim2.fromOffset(w, h)
	self.Size = Vector2.new(w, h)
end

function Library:_MakeDraggable(handle, target)
	handle.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		local startPos, startInput = target.Position, input.Position
		local move, done
		move = UserInputService.InputChanged:Connect(function(i)
			if isMove(i) then
				local d = i.Position - startInput
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
		done = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then move:Disconnect() done:Disconnect() end
		end)
	end)
end

function Library:_BuildGui(opts)
	local parent = opts.Parent or LocalPlayer:WaitForChild("PlayerGui")
	local guiName = "Lumen_" .. (self.Name:gsub("%W", ""))
	local old = parent:FindFirstChild(guiName)
	if old then old:Destroy() end
	local gui = new("ScreenGui", {
		Name = guiName, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true, DisplayOrder = opts.DisplayOrder or 100, Parent = parent,
	})
	self.Gui = gui

	local root = new("Frame", {
		Name = "Root", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(self.Size.X, self.Size.Y), BackgroundTransparency = 1, Visible = false, Parent = gui,
	})
	self.Scale = new("UIScale", { Scale = 1, Parent = root })
	if opts.Shadow ~= false then
		self.Shadow = new("ImageLabel", {
			Name = "Shadow", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 70, 1, 70), Image = "rbxassetid://6014261993", ImageColor3 = Color3.new(0, 0, 0),
			ImageTransparency = 1, ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), Parent = root,
		})
	end
	local main = new("CanvasGroup", {
		Name = "Window", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0,
		BackgroundColor3 = self.Colors.Background, GroupTransparency = 1, Parent = root,
	})
	self:Bind(main, { BackgroundColor3 = "Background" })
	corner(main, 10)
	self:_Stroke(main, "Stroke")
	self.Main = root
	self.Canvas = main
	local topGlow = new("Frame", { Name = "Glow", BackgroundColor3 = self.Colors.Accent, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 240), Parent = main })
	self:Bind(topGlow, { BackgroundColor3 = "Accent" })
	new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.84), NumberSequenceKeypoint.new(1, 1) }), Parent = topGlow })

	-- Title bar
	local title = self:_Frame({ Name = "TitleBar", Size = UDim2.new(1, 0, 0, TITLE_H), BackgroundTransparency = 0.3, Parent = main }, "Sidebar")
	self:_Frame({ Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), Parent = title }, "Stroke")
	local logo = new("Frame", { Position = UDim2.fromOffset(16, 12), Size = UDim2.fromOffset(28, 28), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = title })
	corner(logo, 8)
	local lg = new("UIGradient", { Rotation = 45, Parent = logo })
	self:Bind(lg, { Color = function(c) return ColorSequence.new(c.Accent, c.Accent2) end })
	local logoIcon = self:_Icon(logo, opts.Icon or "diamond", 15, "Text", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	self:Bind(logoIcon, { [logoIcon:IsA("ImageLabel") and "ImageColor3" or "TextColor3"] = function() return Color3.new(1, 1, 1) end })
	self.NameLabel = self:_Text({ Text = self.Name, Font = FONT_B, TextSize = 14, Position = UDim2.fromOffset(56, 9), Size = UDim2.new(1, -150, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd, Parent = title }, "Text")
	self.SubLabel = self:_Text({ Text = self.Subtitle, TextSize = 11, Position = UDim2.fromOffset(56, 28), Size = UDim2.new(1, -150, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, Parent = title }, "SubText")

	local function titleButton(iconKey, x, hoverToken)
		local b = new("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0), Size = UDim2.fromOffset(28, 28), BackgroundColor3 = self.Colors.Hover, BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, Parent = title })
		corner(b, 6)
		local ic = self:_Icon(b, iconKey, 16, "SubText", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		local colorProp = ic:IsA("ImageLabel") and "ImageColor3" or "TextColor3"
		self:Unbind(ic)
		b.MouseEnter:Connect(function()
			self:Tween(b, { BackgroundColor3 = self.Colors[hoverToken], BackgroundTransparency = hoverToken == "Error" and 0.8 or 0.3 }, 0.12)
			self:Tween(ic, { [colorProp] = hoverToken == "Error" and self.Colors.Error or self.Colors.Text }, 0.12)
		end)
		b.MouseLeave:Connect(function()
			self:Tween(b, { BackgroundTransparency = 1 }, 0.15)
			self:Tween(ic, { [colorProp] = self.Colors.SubText }, 0.15)
