Components.ColorPicker = function(section, opts)
	local lib = section.Library
	local color = opts.Default or Color3.new(1, 1, 1)
	local rgb = { math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5) }
	local r = baseRow(section, opts, 40, "header")
	local swatch = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(36, 20), BorderSizePixel = 0, BackgroundColor3 = color, Parent = r.Control })
	corner(swatch, 8)
	lib:_Stroke(swatch, "Stroke")

	local drawer = new("Frame", { BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.new(1, 0, 0, 0), Parent = r.Extra })
	listLayout(drawer, 6)
	local channels, valueLabels = {}, {}
	local hexBox, preview
	local obj = {}

	local function refreshAll(skipIndex)
		swatch.BackgroundColor3 = color
		preview.BackgroundColor3 = color
		hexBox.Text = hexOf(color)
		for i = 1, 3 do
			if i ~= skipIndex then channels[i].Set(rgb[i], true) end
		end
	end
	local function setColor(c, silent)
		color = c
		rgb = { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
		refreshAll()
		if not silent then fire(opts.Callback, color) end
	end

	for i, ch in ipairs({ "R", "G", "B" }) do
		local rowF = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = i, Parent = drawer })
		lib:_Text({ Text = ch, Font = FONT_B, TextSize = 12, Size = UDim2.fromOffset(16, 18), Parent = rowF }, "SubText")
		local holder = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(22, 0), Size = UDim2.new(1, -66, 1, 0), Parent = rowF })
		valueLabels[i] = lib:_Text({ Text = tostring(rgb[i]), TextSize = 12, Position = UDim2.new(1, -36, 0, 0), Size = UDim2.fromOffset(36, 18), TextXAlignment = RIGHT, Parent = rowF }, "Text")
		channels[i] = buildSlider(lib, section.Tab, holder, {
			Min = 0, Max = 255, Increment = 1, Default = rgb[i],
			OnRender = function(v) valueLabels[i].Text = tostring(v) end,
			OnChange = function(v)
				rgb[i] = v
				color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
				refreshAll(i)
				fire(opts.Callback, color)
			end,
		})
	end
	local hexRow = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 4, Parent = drawer })
	hexBox = new("TextBox", { BorderSizePixel = 0, BackgroundColor3 = lib.Colors.Background, Size = UDim2.new(0, 110, 1, 0), Font = FONT, TextSize = 12, TextXAlignment = LEFT, ClearTextOnFocus = false, Text = hexOf(color), PlaceholderText = "#RRGGBB", Parent = hexRow })
	lib:Bind(hexBox, { BackgroundColor3 = "Background", TextColor3 = "Text", PlaceholderColor3 = "SubText" })
	corner(hexBox, 8)
	padding(hexBox, 0, 8, 0, 8)
	local hexStroke = lib:_Stroke(hexBox, "Stroke")
	preview = new("Frame", { Position = UDim2.fromOffset(118, 0), Size = UDim2.new(1, -118, 1, 0), BorderSizePixel = 0, BackgroundColor3 = color, Parent = hexRow })
	corner(preview, 8)
	lib:_Stroke(preview, "Stroke")
	hexBox.FocusLost:Connect(function()
		local c = colorFromHex(hexBox.Text)
		if c then
			setColor(c)
		else
			hexBox.Text = hexOf(color)
			hexStroke.Color = lib.Colors.Error
			lib:Tween(hexStroke, { Color = lib.Colors.Stroke }, 0.6)
		end
	end)

	local isOpen = false
	r.Click.Activated:Connect(function()
		isOpen = not isOpen
		if isOpen then
			r.Extra.Visible = true
			lib:Tween(drawer, { Size = UDim2.new(1, 0, 0, 98) }, 0.25)
		else
			lib:Tween(drawer, { Size = UDim2.new(1, 0, 0, 0) }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, function()
				if not isOpen then r.Extra.Visible = false end
			end)
		end
	end)

	function obj:Get() return color end
	function obj:Set(c, silent) if typeof(c) == "Color3" then setColor(c, silent) end end
	function obj:Serialize() return hexOf(color) end
	function obj:Deserialize(v) local c = colorFromHex(v) if c then setColor(c) end end
	return finish(section, opts, obj, r)
end

--// Configuration ------------------------------------------------------------------------------
function Library:ExportConfig()
	local data = {}
	for flag, obj in pairs(self.Flags) do
		if obj.Serialize then data[flag] = obj:Serialize() end
	end
	return HttpService:JSONEncode(data)
end

function Library:ImportConfig(json)
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok or type(data) ~= "table" then return false, "Invalid configuration data" end
	for flag, v in pairs(data) do
		local obj = self.Flags[flag]
		if obj and obj.Deserialize then pcall(obj.Deserialize, obj, v) end
	end
	return true
end

function Library:SaveConfig(name)
	if not name or name == "" then return false, "Name is empty" end
	local ok, err = pcall(self.ConfigHandler.Save, name, self:ExportConfig())
	if ok then self:Log('Saved config "' .. name .. '"', "Success") end
	return ok, err
end

function Library:LoadConfig(name)
	local ok, json = pcall(self.ConfigHandler.Load, name)
	if not ok or not json then return false, "Configuration not found" end
	local done, err = self:ImportConfig(json)
	if done then self:Log('Loaded config "' .. name .. '"', "Info") end
	return done, err
end

function Library:DeleteConfig(name)
	local ok = pcall(self.ConfigHandler.Delete, name)
	if ok then self:Log('Deleted config "' .. name .. '"', "Warning") end
	return ok
end

function Library:ListConfigs()
	local ok, list = pcall(self.ConfigHandler.List)
	return ok and list or {}
end

