function Library:SetVisible(v)
	if self.Visible == v then return end
	self.Visible = v
	local s = self:_EffectiveScale()
	if v then
		self.Main.Visible = true
		self.Launcher.Visible = false
		self.Scale.Scale = s * 0.9
		self.Canvas.GroupTransparency = 1
		self:Tween(self.Scale, { Scale = s }, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		self:Tween(self.Canvas, { GroupTransparency = 0 }, 0.3)
		if self.Shadow then
			self.Shadow.ImageTransparency = 1
			self:Tween(self.Shadow, { ImageTransparency = 0.45 }, 0.4)
		end
	else
		self:Tween(self.Scale, { Scale = s * 0.94 }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		if self.Shadow then self:Tween(self.Shadow, { ImageTransparency = 1 }, 0.2) end
		self:Tween(self.Canvas, { GroupTransparency = 1 }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, function()
			if not self.Visible then
				self.Main.Visible = false
				self.Launcher.Visible = self.UseLauncher
			end
		end)
	end
end

function Library:Toggle() self:SetVisible(not self.Visible) end

function Library:SetMinimized(v)
	if self.Minimized == v then return end
	self.Minimized = v
	local s = self.Scale.Scale
	local targetH = v and TITLE_H or self.Size.Y
	local curH = self.Main.Size.Y.Offset
	local p = self.Main.Position
	if not v then self.Body.Visible = true end
	self.Grip.Visible = not v
	self:Tween(self.Main, {
		Size = UDim2.fromOffset(self.Size.X, targetH),
		Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + (targetH - curH) * s / 2),
	}, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, function()
		if self.Minimized then self.Body.Visible = false end
	end)
end

function Library:Destroy()
	for _, c in ipairs(self._conns) do c:Disconnect() end
	table.clear(self._conns)
	if self.Gui then self.Gui:Destroy() end
	table.clear(self._bound)
	table.clear(self._themeHooks)
end

--// Activity log -------------------------------------------------------------------------------
function Library:Log(text, kind)
	table.insert(self._events, os.time())
	if #self._events > 300 then table.remove(self._events, 1) end
	table.insert(self.Activity, 1, { Text = text, Kind = kind or "Info", Time = os.time() })
	if #self.Activity > 20 then table.remove(self.Activity) end
	self:_QueueHome()
end

--// Notifications ------------------------------------------------------------------------------
local NotifGlyph = { Success = "check-c", Warning = "alert", Error = "x", Info = "info" }

function Library:Notify(opts)
	if type(opts) == "string" then opts = { Title = opts } end
	opts = opts or {}
	local kind = Status[opts.Type] and opts.Type or "Info"
	local duration = opts.Duration or 4
	self._notifId += 1

	local wrap = new("Frame", { Name = "Notification", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = self._notifId, Parent = self.NotifHolder })
	local card = new("CanvasGroup", { BackgroundColor3 = self.Colors.Surface, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, Position = UDim2.fromOffset(60, 0), GroupTransparency = 1, Parent = wrap })
	self:Bind(card, { BackgroundColor3 = "Surface" })
	corner(card, 8)
	self:_Stroke(card, "Stroke")
	listLayout(card, 0)

	local body = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = 1, Parent = card })
	padding(body, 12, 12, 12, 12)
	local badge = self:_Frame({ Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 0.82, Parent = body }, kind)
	corner(badge, 12)
	if opts.Icon then
		self:_Icon(badge, opts.Icon, 14, kind, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	else
		self:_Icon(badge, NotifGlyph[kind], 14, kind, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
	end
	local tf = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -34, 0, 0), AutomaticSize = AUTO_Y, Parent = body })
	listLayout(tf, 2)
	self:_Text({ Text = opts.Title or "Notification", Font = FONT_B, TextSize = 13, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, LayoutOrder = 1, TextYAlignment = Enum.TextYAlignment.Top, Parent = tf }, "Text")
	local descText = opts.Description or opts.Content
	if descText and descText ~= "" then
		self:_Text({ Text = descText, TextSize = 12, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, LayoutOrder = 2, TextYAlignment = Enum.TextYAlignment.Top, Parent = tf }, "SubText")
	end
	local bar = self:_Frame({ Size = UDim2.new(1, 0, 0, 2), LayoutOrder = 2, Parent = card }, kind)

	local dismissed = false
	local function dismiss()
		if dismissed or not wrap.Parent then return end
		dismissed = true
		local i = table.find(self._notifs, wrap)
		if i then table.remove(self._notifs, i) end
		self:Tween(card, { Position = UDim2.fromOffset(60, 0), GroupTransparency = 1 }, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In, function()
			if not wrap.Parent then return end
			local h = wrap.AbsoluteSize.Y
			wrap.AutomaticSize = Enum.AutomaticSize.None
			wrap.ClipsDescendants = true
			wrap.Size = UDim2.new(1, 0, 0, h)
			self:Tween(wrap, { Size = UDim2.new(1, 0, 0, 0) }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function() wrap:Destroy() end)
		end)
	end
	local hit = new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = wrap })
	hit.Activated:Connect(dismiss)

	self._dismissers = self._dismissers or setmetatable({}, { __mode = "k" })
	self._dismissers[wrap] = dismiss
	table.insert(self._notifs, wrap)
	if #self._notifs > 5 then
		local fn = self._dismissers[self._notifs[1]]
		if fn then fn() end
	end

	self:Tween(card, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, 0.4)
	if duration > 0 then
		TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) }):Play()
		task.delay(duration, dismiss)
	end
	return { Dismiss = dismiss }
end

--// Tabs ---------------------------------------------------------------------------------------
function Library:_NewTab(opts, listParent, order, fixed)
	local tab = setmetatable({ Library = self, Name = opts.Name or "Tab", Icon = opts.Icon or "dot", Fixed = fixed, _order = 1 }, Tab)

	local btn = new("TextButton", { Name = tab.Name, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = self.Colors.Hover, BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = order, Parent = listParent })
	corner(btn, 8)
	local pillStroke = self:_Stroke(btn, "Accent")
	pillStroke.Transparency = 1
	local bar = self:_Frame({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(3, 0), Parent = btn }, "Accent")
	corner(bar, 2)
	local icon = self:_Icon(btn, tab.Icon, 17, "SubText", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.5, 0) })
	local label = self:_Text({ Text = tab.Name, Font = FONT_M, Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -50, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn }, "SubText")
	local colorProp = icon:IsA("ImageLabel") and "ImageColor3" or "TextColor3"
	self:Unbind(icon)
	self:Unbind(label)

	local hovered = false
	local function style(animate)
		local c = self.Colors
		local active = self.Current == tab
		local bg, bgT, fg
		if active then bg, bgT, fg = c.Accent, 0.86, c.Accent
		elseif hovered then bg, bgT, fg = c.Hover, 0.35, c.Text
		else bg, bgT, fg = c.Hover, 1, c.SubText end
		local function apply(inst, props)
			if animate then self:Tween(inst, props, 0.18) else for k, v in pairs(props) do inst[k] = v end end
		end
		apply(btn, { BackgroundColor3 = bg, BackgroundTransparency = bgT })
		apply(label, { TextColor3 = fg, Position = UDim2.fromOffset((hovered or active) and 46 or 42, 0) })
		apply(pillStroke, { Transparency = active and 0.55 or 1 })
		apply(icon, { [colorProp] = fg })
		apply(bar, { Size = UDim2.fromOffset(3, active and 20 or 0) })
	end
	tab._style = style
	btn.MouseEnter:Connect(function() hovered = true style(true) end)
	btn.MouseLeave:Connect(function() hovered = false style(true) end)
	btn.Activated:Connect(function() self:SelectTab(tab) end)

	local page = new("CanvasGroup", { Name = tab.Name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = self.Content })
	local scroll = new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = AUTO_Y, ScrollBarThickness = 3, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = page })
	self:Bind(scroll, { ScrollBarImageColor3 = "SubText" })
	padding(scroll, 16, 18, 16, 16)
	listLayout(scroll, 12)
	tab.Page, tab.Scroll, tab.Button = page, scroll, btn

	if not opts.NoHeader then
		local head = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = 0, Parent = scroll })
		listLayout(head, 2)
		self:_Text({ Text = tab.Name, Font = FONT_B, TextSize = 22, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, Parent = head }, "Text")
		if opts.Description and opts.Description ~= "" then
			self:_Text({ Text = opts.Description, TextSize = 13, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, Parent = head }, "SubText")
		end
	end

	table.insert(self._allTabs, tab)
	style(false)
	self:_QueueHome()
	return tab
end

function Library:CreateTab(opts)
	if type(opts) == "string" then opts = { Name = opts } end
	opts = opts or {}
	local order = (#self.Tabs + 1) * 2
	if opts.Group and opts.Group ~= self._lastGroup then
		self._lastGroup = opts.Group
		self:_Text({ Text = string.upper(opts.Group), Font = FONT_B, TextSize = 11, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order - 1, TextYAlignment = Enum.TextYAlignment.Bottom, Parent = self.TabList }, "SubText")
	end
	local tab = self:_NewTab(opts, self.TabList, order, false)
	table.insert(self.Tabs, tab)
	return tab
end

function Library:SelectTab(target)
	if type(target) == "string" then
		for _, t in ipairs(self._allTabs) do if t.Name == target then target = t break end end
	end
	if type(target) ~= "table" or target == self.Current then return end
	local old = self.Current
	self.Current = target
	if old then
		old._style(true)
		self:Tween(old.Page, { GroupTransparency = 1 }, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In, function()
			if self.Current ~= old then old.Page.Visible = false end
		end)
	end
	target.Page.Visible = true
	target.Page.GroupTransparency = 1
	local function key(t) return (t.Fixed and 1000 or 0) + t.Button.LayoutOrder end
	local dir = (not old or key(target) >= key(old)) and 16 or -16
	target.Page.Position = UDim2.fromOffset(0, dir)
	self:Tween(target.Page, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, 0.3)
	target._style(true)
	if target == self.Home and target._ui then target._ui.replay = true end
	self:_Stagger(target)
	self:_QueueHome()
end

function Tab:Select() self.Library:SelectTab(self) end

function Tab:CreateSection(name)
	local lib = self.Library
	local card = lib:_Card({ Name = "Section", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = self._order, Parent = self.Scroll }, 10)
	self._order += 1
	local inner = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, Parent = card })
	padding(inner, 16, 16, 16, 16)
	listLayout(inner, 12)
	if name and name ~= "" then
		local head = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 0, Parent = inner })
		local pill = lib:_Frame({ Position = UDim2.fromOffset(0, 3), Size = UDim2.fromOffset(4, 14), Parent = head }, "Accent")
		corner(pill, 2)
		lib:_Text({ Text = tostring(name), Font = FONT_B, TextSize = 14, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -12, 1, 0), Parent = head }, "Text")
	end
	local sbody = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = 1, Parent = inner })
	listLayout(sbody, 8)
	return setmetatable({ Library = lib, Tab = self, Card = card, Body = sbody, _order = 1 }, Section)
end

-- Section:CreateX(opts) resolves to Components.X(section, opts) so new components are drop-in.
Section.__index = function(_, key)
	local name = type(key) == "string" and key:match("^Create(%w+)$")
	local ctor = name and Components[name]
	if ctor then return function(self, opts) return ctor(self, opts or {}) end end
	return nil
end

function Library.RegisterComponent(name, ctor) Components[name] = ctor end

-- Tab:CreateButton(...) etc. drop components into an automatic untitled section.
Tab.__index = function(t, key)
	local v = rawget(Tab, key)
	if v ~= nil then return v end
	local name = type(key) == "string" and key:match("^Create(%w+)$")
	if name and Components[name] then
		return function(self, opts)
			if not rawget(self, "_default") then rawset(self, "_default", self:CreateSection()) end
			return rawget(self, "_default")[key](rawget(self, "_default"), opts)
		end
	end
	return nil
end

--// Component helpers --------------------------------------------------------------------------
-- baseRow builds the card row: Header[ TextFrame(title, desc) | Control ] and a collapsible Extra area.
local function baseRow(section, opts, controlWidth, click)
	local lib = section.Library
	local row = new(click == "row" and "TextButton" or "Frame", {
		Name = opts.Name or "Element", BorderSizePixel = 0, BackgroundColor3 = lib.Colors.Surface2,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = section._order, Parent = section.Body,
	})
	if click == "row" then row.Text = "" row.AutoButtonColor = false end
	section._order += 1
	lib:Bind(row, { BackgroundColor3 = "Surface2" })
	corner(row, 8)
	local stroke = lib:_Stroke(row, "Stroke")
	padding(row, 12, 14, 12, 14)
	listLayout(row, 8)

	local header = new(click == "header" and "TextButton" or "Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = 1, Parent = row })
	if click == "header" then header.Text = "" header.AutoButtonColor = false end
	local hl = listLayout(header, 10, true)
	hl.VerticalAlignment = Enum.VerticalAlignment.Center

	local textFrame = new("Frame", { BackgroundTransparency = 1, Size = controlWidth and UDim2.new(1, -(controlWidth + 10), 0, 0) or UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = 1, Parent = header })
	listLayout(textFrame, 2)
	local title = lib:_Text({ Text = opts.Name or opts.Title or "", Font = FONT_M, TextSize = 14, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 1, Parent = textFrame }, "Text")
	local descText = opts.Description or opts.Content or ""
	local desc = lib:_Text({ Text = descText, TextSize = 12, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, Visible = descText ~= "", Parent = textFrame }, "SubText")

	local control
	if controlWidth then
		control = new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(controlWidth, 24), LayoutOrder = 2, Parent = header })
	end
	local extra = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AUTO_Y, LayoutOrder = 2, Visible = false, Parent = row })
	listLayout(extra, 6)
	return { Row = row, Header = header, Title = title, Desc = desc, Control = control, Extra = extra, Stroke = stroke, Click = click == "header" and header or row }
end

local function finish(section, opts, obj, r)
	local lib = section.Library
	obj.Row = r.Row
	obj.Name = opts.Name or opts.Title
	function obj:SetVisible(v) r.Row.Visible = v end
	function obj:Destroy()
		if obj._cleanup then obj._cleanup() end
		if opts.Flag and lib.Flags[opts.Flag] == obj then lib.Flags[opts.Flag] = nil end
		r.Row:Destroy()
		lib:_QueueHome()
	end
	if opts.Flag then lib.Flags[opts.Flag] = obj end
	return obj
end

local function fire(cb, ...)
	if cb then task.spawn(cb, ...) end
end

-- Press feedback: content insets slightly (reads as a ~0.97 scale-down without breaking auto layout).
local function pressInset(lib, row)
	local pad = row:FindFirstChildOfClass("UIPadding")
	if not pad then return end
	local t, r, b, l = pad.PaddingTop.Offset, pad.PaddingRight.Offset, pad.PaddingBottom.Offset, pad.PaddingLeft.Offset
	local function set(down)
		lib:Tween(pad, {
			PaddingTop = UDim.new(0, t + (down and 1 or 0)), PaddingBottom = UDim.new(0, b + (down and 1 or 0)),
			PaddingLeft = UDim.new(0, l + (down and 4 or 0)), PaddingRight = UDim.new(0, r + (down and 4 or 0)),
		}, 0.12, Enum.EasingStyle.Quad)
	end
	row.InputBegan:Connect(function(i) if isPress(i) then set(true) end end)
	row.InputEnded:Connect(function(i) if isPress(i) then set(false) end end)
	row.MouseLeave:Connect(function() set(false) end)
end

-- Reusable slider track. cfg: Min, Max, Increment, Default, OnRender(v), OnChange(v)
local function buildSlider(lib, tab, parent, cfg)
	local min, max = cfg.Min, cfg.Max
	local inc = (cfg.Increment and cfg.Increment > 0) and cfg.Increment or 1
	local value
	local decimals = 0
	local incText = tostring(inc)
	local dot = incText:find("%.")
	if dot then decimals = #incText - dot end

	local holder = new("TextButton", { BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 22), Parent = parent })
	local track = lib:_Frame({ AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 8), Parent = holder }, "Stroke")
	corner(track, 4)
	local fill = new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = track })
	corner(fill, 4)
	local fglow = lib:_Stroke(fill, "Accent", 3)
	fglow.Transparency = 0.72
	local grad = new("UIGradient", { Parent = fill })
	lib:Bind(grad, { Color = function(c) return ColorSequence.new(c.Accent, c.Accent2) end })
	local knob = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2, Parent = track })
	corner(knob, 8)
	lib:_Stroke(knob, "Accent", 2)

	local function snap(v)
		v = math.clamp(v, min, max)
		v = min + math.floor((v - min) / inc + 0.5) * inc
		v = math.clamp(v, min, max)
		local m = 10 ^ decimals
		return math.floor(v * m + 0.5) / m
	end
	local obj = { Holder = holder }
	local function render(animate)
		local a = max > min and (value - min) / (max - min) or 0
		fglow.Enabled = a > 0.01
		if animate then
			lib:Tween(fill, { Size = UDim2.fromScale(a, 1) }, 0.1, Enum.EasingStyle.Quad)
			lib:Tween(knob, { Position = UDim2.fromScale(a, 0.5) }, 0.1, Enum.EasingStyle.Quad)
		else
			fill.Size = UDim2.fromScale(a, 1)
			knob.Position = UDim2.fromScale(a, 0.5)
		end
		if cfg.OnRender then cfg.OnRender(value) end
	end
	function obj.Set(v, silent)
		v = snap(tonumber(v) or min)
		if v == value then return end
		value = v
		render(true)
		if not silent and cfg.OnChange then cfg.OnChange(value) end
	end
	function obj.Get() return value end
	value = snap(cfg.Default or min)
	render(false)

	holder.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		local function fromX(x)
			local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			obj.Set(min + rel * (max - min))
		end
		fromX(input.Position.X)
		if tab and tab.Scroll then tab.Scroll.ScrollingEnabled = false end
		lib:Tween(knob, { Size = UDim2.fromOffset(21, 21) }, 0.15, Enum.EasingStyle.Back)
		local move, done
		move = UserInputService.InputChanged:Connect(function(i)
			if isMove(i) then fromX(i.Position.X) end
		end)
		done = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				move:Disconnect() done:Disconnect()
				if tab and tab.Scroll then tab.Scroll.ScrollingEnabled = true end
				lib:Tween(knob, { Size = UDim2.fromOffset(16, 16) }, 0.2, Enum.EasingStyle.Back)
			end
		end)
	end)
	return obj
end

