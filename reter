Components.Dropdown = function(section, opts)
	local lib = section.Library
	local values = table.clone(opts.Values or opts.Options or {})
	local multi = opts.Multi == true
	local searchable = opts.Search ~= false
	local selected, single, isOpen = {}, nil, false
	local r = baseRow(section, opts, 150, "header")

	local chip = lib:_Frame({ Size = UDim2.fromScale(1, 1), Parent = r.Control }, "Background")
	corner(chip, 8)
	lib:_Stroke(chip, "Stroke")
	local chipText = lib:_Text({ TextSize = 12, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -28, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = chip }, "Text")
	local arrow = lib:_Icon(chip, "chevron", 14, "SubText", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Rotation = 90 })

	r.Row.ClipsDescendants = false
	local drawer = new("Frame", { BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.new(1, 0, 0, 0), Parent = r.Extra })
	listLayout(drawer, 6)
	local searchBox
	if searchable then
		searchBox = new("TextBox", { BorderSizePixel = 0, BackgroundColor3 = lib.Colors.Background, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 1, Font = FONT, TextSize = 12, TextXAlignment = LEFT, PlaceholderText = "Search...", Text = "", ClearTextOnFocus = false, Parent = drawer })
		lib:Bind(searchBox, { BackgroundColor3 = "Background", TextColor3 = "Text", PlaceholderColor3 = "SubText" })
		corner(searchBox, 8)
		padding(searchBox, 0, 8, 0, 8)
		lib:_Stroke(searchBox, "Stroke")
	end
	local list = new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 28), CanvasSize = UDim2.new(), AutomaticCanvasSize = AUTO_Y, ScrollBarThickness = 3, LayoutOrder = 2, Parent = drawer })
	lib:Bind(list, { ScrollBarImageColor3 = "SubText" })
	listLayout(list, 2)

	local entries = {}
	local function totalHeight()
		local lh = math.max(math.min(#values, 5), 1) * 28
		list.Size = UDim2.new(1, 0, 0, lh)
		return lh + (searchBox and 32 or 0)
	end
	local obj = {}
	function obj:Get()
		if multi then
			local t = {}
			for _, v in ipairs(values) do if selected[v] then t[#t + 1] = v end end
			return t
		end
		return single
	end
	local function display()
		if multi then
			local t = obj:Get()
			chipText.Text = #t > 0 and table.concat(t, ", ") or (opts.Placeholder or "None")
		else
			chipText.Text = single and tostring(single) or (opts.Placeholder or "Select...")
		end
	end
	local function refreshStyles()
		local c = lib.Colors
		for _, e in ipairs(entries) do
			local on = multi and selected[e.name] or (not multi and single == e.name)
			e.btn.BackgroundColor3 = c.Accent
			e.btn.BackgroundTransparency = on and 0.85 or 1
			e.label.TextColor3 = on and c.Accent or c.Text
			e.check.Visible = on and true or false
		end
	end
	lib:OnTheme(refreshStyles, r.Row)

	local setOpen
	local function choose(name)
		if multi then selected[name] = not selected[name] or nil else single = name end
		display() refreshStyles()
		fire(opts.Callback, obj:Get())
		if not multi then setOpen(false) end
	end
	local function rebuild()
		for _, e in ipairs(entries) do e.btn:Destroy() end
		entries = {}
		for i, name in ipairs(values) do
			local btn = new("TextButton", { BackgroundColor3 = lib.Colors.Accent, BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = i, Parent = list })
			corner(btn, 8)
			local label = lib:_Text({ Text = tostring(name), Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -34, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn }, "Text")
			lib:Unbind(label)
			local check = lib:_Icon(btn, "check", 14, "Accent", { Position = UDim2.new(1, -24, 0.5, -7), Visible = false })
			btn.MouseEnter:Connect(function() if btn.BackgroundTransparency == 1 then lib:Tween(btn, { BackgroundColor3 = lib.Colors.Hover, BackgroundTransparency = 0.4 }, 0.1) end end)
			btn.MouseLeave:Connect(function() refreshStyles() end)
			btn.Activated:Connect(function() choose(name) end)
			entries[#entries + 1] = { btn = btn, label = label, check = check, name = name }
		end
		refreshStyles()
	end
	if searchBox then
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			local q = searchBox.Text:lower()
			for _, e in ipairs(entries) do
				e.btn.Visible = q == "" or tostring(e.name):lower():find(q, 1, true) ~= nil
			end
		end)
	end

	setOpen = function(v)
		isOpen = v
		lib:Tween(arrow, { Rotation = v and 270 or 90 }, 0.2)
		if v then
			r.Extra.Visible = true
			lib:Tween(drawer, { Size = UDim2.new(1, 0, 0, totalHeight()) }, 0.25)
		else
			if searchBox then searchBox.Text = "" end
			lib:Tween(drawer, { Size = UDim2.new(1, 0, 0, 0) }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In, function()
				if not isOpen then r.Extra.Visible = false end
			end)
		end
	end
	r.Click.Activated:Connect(function() setOpen(not isOpen) end)

	function obj:Set(v, silent)
		selected, single = {}, nil
		if multi then
			for _, name in ipairs(type(v) == "table" and v or {}) do
				if table.find(values, name) then selected[name] = true end
			end
		else
			if type(v) == "table" then v = v[1] end
			single = (v ~= nil and table.find(values, v)) and v or nil
		end
		display() refreshStyles()
		if not silent then fire(opts.Callback, obj:Get()) end
	end
	function obj:Refresh(newValues)
		values = table.clone(newValues or {})
		local keep = obj:Get()
		rebuild()
		obj:Set(keep, true)
		if isOpen then lib:Tween(drawer, { Size = UDim2.new(1, 0, 0, totalHeight()) }, 0.2) end
	end
	function obj:Serialize() return obj:Get() end
	function obj:Deserialize(v) obj:Set(v) end
	rebuild()
	obj:Set(opts.Default, true)
	return finish(section, opts, obj, r)
end

Components.Textbox = function(section, opts)
	local lib = section.Library
	local r = baseRow(section, opts, 160)
	local box = new("TextBox", { BorderSizePixel = 0, BackgroundColor3 = lib.Colors.Background, Size = UDim2.fromScale(1, 1), Font = FONT, TextSize = 12, TextXAlignment = LEFT, ClearTextOnFocus = false, Text = opts.Default or "", PlaceholderText = opts.Placeholder or "Type here...", TextTruncate = Enum.TextTruncate.AtEnd, Parent = r.Control })
	lib:Bind(box, { BackgroundColor3 = "Background", TextColor3 = "Text", PlaceholderColor3 = "SubText" })
	corner(box, 8)
	padding(box, 0, 8, 0, 8)
	local stroke = lib:_Stroke(box, "Stroke")
	local last = box.Text
	local obj = {}

	local function validate(text)
		if opts.Numeric then
			local n = tonumber(text)
			if not n then return false end
			if opts.Min and n < opts.Min then return false end
			if opts.Max and n > opts.Max then return false end
			if opts.Validate and not opts.Validate(n) then return false end
			return true, n
		end
		if opts.MaxLength and #text > opts.MaxLength then return false end
		if opts.Validate and not opts.Validate(text) then return false end
		return true, text
	end
	box.Focused:Connect(function() lib:Tween(stroke, { Color = lib.Colors.Accent }, 0.15) end)
	box.FocusLost:Connect(function()
		lib:Tween(stroke, { Color = lib.Colors.Stroke }, 0.15)
		local ok, parsed = validate(box.Text)
		if ok then
			last = box.Text
			fire(opts.Callback, parsed)
		else
			box.Text = last
			stroke.Color = lib.Colors.Error
			lib:Tween(stroke, { Color = lib.Colors.Stroke }, 0.6)
		end
	end)
	function obj:Get() return box.Text end
	function obj:Set(v, silent)
		box.Text = tostring(v or "")
		last = box.Text
		if not silent then
			local ok, parsed = validate(last)
			if ok then fire(opts.Callback, parsed) end
		end
	end
	function obj:Serialize() return box.Text end
	function obj:Deserialize(v) obj:Set(v) end
	return finish(section, opts, obj, r)
end

Components.Keybind = function(section, opts)
	local lib = section.Library
	local mode = opts.Mode == "Hold" and "Hold" or "Toggle"
	local key = opts.Default
	if type(key) == "string" then
		local ok, k = pcall(function() return Enum.KeyCode[key] end)
		key = ok and k or nil
	end
	local r = baseRow(section, opts, 140)
	local chip = new("TextButton", { BorderSizePixel = 0, BackgroundColor3 = lib.Colors.Background, Size = UDim2.fromScale(1, 1), Font = FONT_M, TextSize = 11, AutoButtonColor = false, Text = "", TextTruncate = Enum.TextTruncate.AtEnd, Parent = r.Control })
	lib:Bind(chip, { BackgroundColor3 = "Background" })
	corner(chip, 8)
	local stroke = lib:_Stroke(chip, "Stroke")
	local listening, state = false, false
	local conns = {}
	local obj = {}

	local function refresh()
		chip.Text = listening and "Press a key..." or ((key and key.Name or "None") .. " · " .. mode)
		chip.TextColor3 = listening and lib.Colors.Accent or lib.Colors.Text
		lib:Tween(stroke, { Color = listening and lib.Colors.Accent or lib.Colors.Stroke }, 0.15)
	end
	lib:OnTheme(refresh, chip)
	refresh()

	chip.Activated:Connect(function()
		listening = true
		lib._listening = true
		refresh()
	end)
	chip.MouseButton2Click:Connect(function()
		mode = mode == "Toggle" and "Hold" or "Toggle"
		state = false
		refresh()
	end)
	table.insert(conns, UserInputService.InputBegan:Connect(function(input, gp)
		if listening then
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			listening, lib._listening, lib._bindStamp = false, false, os.clock()
			if input.KeyCode == Enum.KeyCode.Backspace then key = nil
			elseif input.KeyCode ~= Enum.KeyCode.Escape then key = input.KeyCode end
			refresh()
			fire(opts.OnChanged, key)
			return
		end
		if gp or not key or input.KeyCode ~= key then return end
		if mode == "Toggle" then
			state = not state
			fire(opts.Callback, state)
		else
			state = true
			fire(opts.Callback, true)
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if mode == "Hold" and state and key and input.KeyCode == key then
			state = false
			fire(opts.Callback, false)
		end
	end))

	function obj:Get() return key and key.Name or nil end
	function obj:GetState() return state end
	function obj:Set(k, silent)
		if type(k) == "string" then
			local ok, v = pcall(function() return Enum.KeyCode[k] end)
			k = ok and v or nil
		end
		key = k
		refresh()
		if not silent then fire(opts.OnChanged, key) end
	end
	function obj:Serialize() return { Key = key and key.Name or nil, Mode = mode } end
	function obj:Deserialize(v)
		if type(v) ~= "table" then return end
		if v.Mode == "Hold" or v.Mode == "Toggle" then mode = v.Mode end
		obj:Set(v.Key)
	end
	obj._cleanup = function() for _, c in ipairs(conns) do c:Disconnect() end end
	return finish(section, opts, obj, r)
end

