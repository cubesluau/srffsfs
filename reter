Components.Button = function(section, opts)
	local lib = section.Library
	local r = baseRow(section, opts, 64, "row")
	local row = r.Row
	local pill = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(60, 26), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = r.Control })
	corner(pill, 13)
	local grad = new("UIGradient", { Rotation = 0, Parent = pill })
	lib:Bind(grad, { Color = function(c) return ColorSequence.new(c.Accent, c.Accent2) end })
	local glow = lib:_Stroke(pill, "Accent", 2)
	glow.Transparency = 1
	local pillText = lib:_Text({ Text = opts.ButtonText or "Run", Font = FONT_B, TextSize = 12, Size = UDim2.fromScale(1, 1), TextXAlignment = CENTER, Parent = pill }, "Text")
	lib:Bind(pillText, { TextColor3 = function() return Color3.new(1, 1, 1) end })
	local pillScale = new("UIScale", { Parent = pill })
	pressInset(lib, row)

	local hovered = false
	row.MouseEnter:Connect(function()
		hovered = true
		lib:Tween(row, { BackgroundColor3 = lib.Colors.Hover }, 0.15)
		lib:Tween(r.Stroke, { Color = lib.Colors.Accent }, 0.2)
		lib:Tween(glow, { Transparency = 0.5 }, 0.2)
		lib:Tween(grad, { Offset = Vector2.new(-0.3, 0) }, 0.3)
	end)
	row.MouseLeave:Connect(function()
		hovered = false
		lib:Tween(row, { BackgroundColor3 = lib.Colors.Surface2 }, 0.2)
		lib:Tween(r.Stroke, { Color = lib.Colors.Stroke }, 0.2)
		lib:Tween(glow, { Transparency = 1 }, 0.2)
		lib:Tween(grad, { Offset = Vector2.new(0, 0) }, 0.3)
	end)
	row.InputBegan:Connect(function(i) if isPress(i) then lib:Tween(pillScale, { Scale = 0.93 }, 0.1, Enum.EasingStyle.Quad) end end)
	row.InputEnded:Connect(function(i) if isPress(i) then lib:Tween(pillScale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back) end end)

	local obj = {}
	function obj:Fire() fire(opts.Callback) end
	function obj:SetText(t) r.Title.Text = t end
	row.Activated:Connect(function()
		local soft = lib.Colors.Surface2:Lerp(lib.Colors.Accent, 0.35)
		lib:Tween(row, { BackgroundColor3 = soft }, 0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function()
			lib:Tween(row, { BackgroundColor3 = hovered and lib.Colors.Hover or lib.Colors.Surface2 }, 0.35)
		end)
		lib:Log('Pressed "' .. r.Title.Text .. '"', "Info")
		obj:Fire()
	end)
	return finish(section, opts, obj, r)
end

Components.Toggle = function(section, opts)
	local lib = section.Library
	local value = opts.Default == true
	local r = baseRow(section, opts, 46, "row")
	local row = r.Row
	local track = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(44, 24), BorderSizePixel = 0, Parent = r.Control })
	corner(track, 12)
	local glow = lib:_Stroke(track, "Accent", 2)
	local knob = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = track })
	corner(knob, 9)
	lib:Bind(track, { BackgroundColor3 = function(c) return value and c.Accent or c.Stroke end })
	local function render(animate)
		local pos = UDim2.new(0, value and 23 or 3, 0.5, 0)
		local col = value and lib.Colors.Accent or lib.Colors.Stroke
		local gt = value and 0.55 or 1
		if animate then
			lib:Tween(track, { BackgroundColor3 = col }, 0.25)
			lib:Tween(glow, { Transparency = gt }, 0.25)
			lib:Tween(knob, { Position = pos }, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			lib:Tween(knob, { Size = UDim2.fromOffset(24, 18) }, 0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, function()
				lib:Tween(knob, { Size = UDim2.fromOffset(18, 18) }, 0.3, Enum.EasingStyle.Back)
			end)
		else
			track.BackgroundColor3 = col
			glow.Transparency = gt
			knob.Position = pos
		end
	end
	render(false)

	local obj = {}
	function obj:Get() return value end
	function obj:Set(v, silent)
		v = v and true or false
		if v == value then return end
		value = v
		render(true)
		lib:_QueueHome()
		if not silent then fire(opts.Callback, value) end
	end
	function obj:Serialize() return value end
	function obj:Deserialize(v) self:Set(v) end
	obj._cleanup = function()
		local i = table.find(lib.Toggles, obj)
		if i then table.remove(lib.Toggles, i) end
	end
	table.insert(lib.Toggles, obj)

	pressInset(lib, row)
	local hovered = false
	row.MouseEnter:Connect(function()
		hovered = true
		lib:Tween(row, { BackgroundColor3 = lib.Colors.Hover }, 0.15)
		lib:Tween(r.Stroke, { Color = lib.Colors.Accent }, 0.2)
	end)
	row.MouseLeave:Connect(function()
		hovered = false
		lib:Tween(row, { BackgroundColor3 = lib.Colors.Surface2 }, 0.2)
		lib:Tween(r.Stroke, { Color = lib.Colors.Stroke }, 0.2)
	end)
	row.Activated:Connect(function()
		obj:Set(not value)
		lib:Log(r.Title.Text .. (value and " enabled" or " disabled"), value and "Success" or "Warning")
	end)
	if opts.CallbackOnCreate then fire(opts.Callback, value) end
	return finish(section, opts, obj, r)
end

